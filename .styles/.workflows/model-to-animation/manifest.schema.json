{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "opencaw-model-animation/v1"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "asset": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "staging": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "recipe": {
      "type": "string",
      "minLength": 1
    },
    "rights": {
      "type": "string",
      "minLength": 1
    },
    "blender": {
      "type": "string",
      "minLength": 1
    },
    "engineReceipt": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "skinned",
        "articulated",
        "rigid"
      ]
    },
    "blenderSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "engine": {
      "type": "object"
    },
    "originals": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "sourceInputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "baselineInputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "stages": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "inspect",
          "prepare",
          "rig",
          "motion",
          "bake",
          "export",
          "review"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/stage"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "rig",
              "motion",
              "independent",
              "human"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "evidenceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "kind",
          "reviewer",
          "evidence",
          "evidenceHash",
          "fingerprint",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "effectiveRecipe": {
      "type": "string",
      "minLength": 1
    },
    "effectiveRecipeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lastSuccessfulMotion": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/stage"
            },
            {
              "properties": {
                "status": {
                  "const": "complete"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "task",
    "asset",
    "version",
    "actor",
    "profile",
    "staging",
    "model",
    "recipe",
    "rights",
    "blender",
    "blenderSha256",
    "engineReceipt",
    "engine",
    "originals",
    "sourceInputs",
    "baselineInputs",
    "stages",
    "approvals",
    "history",
    "effectiveRecipe",
    "effectiveRecipeSha256"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencaw.local/schemas/motion/manifest-v1",
  "title": "Persistent guarded native model-to-animation state",
  "$defs": {
    "stage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "running",
            "failed",
            "complete"
          ]
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "externalInputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "operation",
        "attempt",
        "inputs",
        "externalInputs",
        "outputs",
        "artifacts"
      ],
      "additionalProperties": false
    }
  }
}
