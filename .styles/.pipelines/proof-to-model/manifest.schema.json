{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencaw.local/schemas/proof-to-model/manifest-v1",
  "title": "PROOF_TO_MODEL asset manifest",
  "type": "object",
  "required": ["schemaVersion","asset","version","task","staging","styleHash","proof","rights","recipe","toolchain","createdBy","stages","approvals","history"],
  "properties": {
    "schemaVersion": {"const":1},
    "asset": {"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"},
    "version": {"type":"string"}, "task": {"type":"string"}, "staging": {"type":"string"},
    "styleHash": {"$ref":"#/$defs/hash"}, "proof": {"type":"string"},
    "proofMetadata": {"type":"string"}, "brief": {"type":"string"},
    "rights": {"type":"string"}, "recipe": {"type":"string"},
    "toolchain": {"type":"string"}, "createdBy": {"type":"string","minLength":1},
    "stages": {"type":"object","additionalProperties":{"$ref":"#/$defs/stage"}},
    "approvals": {"type":"array","items":{"$ref":"#/$defs/approval"}},
    "history": {"type":"array","items":{"type":"object"}}
  },
  "$defs": {
    "hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "hashes": {"type":"object","additionalProperties":{"$ref":"#/$defs/hash"}},
    "stage": {
      "type":"object","required":["status","fingerprint","attempt","inputs","outputs","artifacts"],
      "properties": {
        "status":{"enum":["running","failed","complete"]},
        "fingerprint":{"$ref":"#/$defs/hash"},"attempt":{"type":"string"},
        "error":{"type":["string","null"]},"inputs":{"$ref":"#/$defs/hashes"},
        "externalInputs":{"$ref":"#/$defs/hashes"},"outputs":{"$ref":"#/$defs/hashes"},
        "artifacts":{"type":"object","additionalProperties":{"type":"string"}}
      }
    },
    "approval": {
      "type":"object","required":["kind","reviewer","evidence","evidenceHash","fingerprint","timestamp"],
      "properties": {
        "kind":{"enum":["proof","preprocessing","independent","human","rigging","animation"]},
        "reviewer":{"type":"string","minLength":1},"evidence":{"type":"string"},
        "evidenceHash":{"$ref":"#/$defs/hash"},"fingerprint":{"$ref":"#/$defs/hash"},
        "timestamp":{"type":"string","format":"date-time"}
      }
    }
  }
}
