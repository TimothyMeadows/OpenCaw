{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencaw.dev/schemas/proof-to-model/finishing-settings.schema.json",
  "title": "Explicit finishing-only settings",
  "$comment": "Native parsing additionally limits the settings file to 65536 UTF-8 bytes and depth16, rejects duplicate keys and requires a confined project-relative regular file. Integer types follow JSON Schema numeric integer semantics. V2 explicitly selects reviewed rigid HIGH/LOW pairs and an enforced Windows owned-job aggregate committed-memory ceiling; unsupported enforcement blocks before launch. Existing v1 remains unchanged.",
  "oneOf": [
    {
      "$ref": "#/$defs/legacyQuadriFlow"
    },
    {
      "$ref": "#/$defs/rigidParts"
    }
  ],
  "$defs": {
    "legacyQuadriFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "topologyPreparation",
        "collision"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "quadriFlow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coordinateScale"
          ],
          "properties": {
            "coordinateScale": {
              "type": "integer",
              "enum": [
                1,
                2,
                4,
                8,
                16,
                32,
                64,
                128,
                256,
                512,
                1024
              ],
              "description": "Explicit transient solver-coordinate factor. Omission retains effective1; selecting a factor never changes project/world scale or selects a repair fallback."
            },
            "simplification": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "targetTriangles",
                "maxVertexSurfaceErrorMetres",
                "protectedRegions"
              ],
              "properties": {
                "method": {
                  "const": "collapse"
                },
                "targetTriangles": {
                  "type": "integer",
                  "minimum": 4,
                  "maximum": 8000000
                },
                "maxVertexSurfaceErrorMetres": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "protectedRegions": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 128,
                  "description": "Original prepared vertices inside any explicit world-metre box, including its boundaries, must survive simplification exactly once under their original identities with bit-identical stored local coordinates and unchanged source transform. The fixed producer must prove retention; a reduction bias alone does not satisfy this contract.",
                  "$comment": "Native parsing additionally requires unique ordinal region IDs and min < max on every axis. Held vertices do not freeze faces or continuous patch interiors. Protection does not replace the triangle cap, component/topology guards or all-source/all-candidate vertex-to-opposing-surface error checks. Those sampled vertex checks are not a continuous Hausdorff guarantee.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "min",
                      "max"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
                        "not": {
                          "pattern": "[^A-Za-z0-9._-]"
                        }
                      },
                      "min": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": "number",
                          "minimum": -1000000000,
                          "maximum": 1000000000
                        }
                      },
                      "max": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": "number",
                          "minimum": -1000000000,
                          "maximum": 1000000000
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "topologyPreparation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "const": "none"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "voxelSize",
                "maxEstimatedVoxels",
                "maxPreparedTriangles"
              ],
              "properties": {
                "method": {
                  "const": "voxel-remesh"
                },
                "voxelSize": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "maxEstimatedVoxels": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000000000
                },
                "maxPreparedTriangles": {
                  "type": "integer",
                  "minimum": 4,
                  "maximum": 20000000
                }
              }
            }
          ]
        },
        "collision": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "const": "exact-hull"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "padding",
                "maxVolumeRatio"
              ],
              "properties": {
                "method": {
                  "const": "kdop-26"
                },
                "padding": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxVolumeRatio": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            }
          ]
        }
      }
    },
    "rigidParts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "method",
        "topologyPreparation",
        "collision",
        "rigidParts",
        "resources"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2,
          "type": "integer"
        },
        "method": {
          "const": "rigid-parts"
        },
        "topologyPreparation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "const": "none"
            }
          }
        },
        "collision": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "const": "exact-hull"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "padding",
                "maxVolumeRatio"
              ],
              "properties": {
                "method": {
                  "const": "kdop-26"
                },
                "padding": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxVolumeRatio": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 100
                },
                "frame": {
                  "type": "string",
                  "enum": [
                    "world",
                    "principal-axes-v1"
                  ],
                  "description": "Explicit support-direction frame; omission retains world. Unsupported covariance rejects without fallback."
                }
              }
            }
          ]
        },
        "rigidParts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handoff",
            "handoffSha256",
            "reviewEvidence",
            "reviewEvidenceSha256",
            "maxLod0Triangles",
            "maxGlbBytes"
          ],
          "dependentRequired": {
            "sourceTopology": ["lods"]
          },
          "allOf": [
            {
              "if": {
                "required": ["lods"],
                "properties": {"lods": {"required": ["contactPolicy"]}}
              },
              "then": {"required": ["sourceTopology"]}
            }
          ],
          "properties": {
            "handoff": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Native validation additionally rejects traversal, reserved names, backslashes, absolute paths, reparse points and filesystem aliases."
            },
            "handoffSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "reviewEvidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Native validation additionally rejects traversal, reserved names, backslashes, absolute paths, reparse points and filesystem aliases."
            },
            "reviewEvidenceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "maxLod0Triangles": {
              "type": "integer",
              "minimum": 4,
              "maximum": 8000000
            },
            "maxGlbBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 2147483648
            },
            "uvAtlas": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "islandMarginPixels"
              ],
              "description": "Optional explicit pixel-based SmartProject padding. Native admission also requires islandMarginPixels <= recipe.textureSize/8. Absence preserves the recipe-driven legacy call. Padding arguments do not prove actual raster spacing or coverage.",
              "properties": {
                "method": {
                  "const": "smart-project-pixels"
                },
                "islandMarginPixels": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                "triangleRepair": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "method",
                    "minCellPixels",
                    "maxTriangles"
                  ],
                  "description": "Optional explicit bounded density-preserving triangle isolation. Minimum cell size is exactly four pixels, and the explicit triangle limit is1..16384. Recipe admission additionally requires positive power-of-two textureSize at most8192 and minimum cell plus margins fit. Native feasibility, density and final atlas quality require separate evidence; no automatic selection or quality acceptance.",
                  "properties": {
                    "method": {
                      "const": "density-preserving-isolated-cells-v1"
                    },
                    "minCellPixels": {
                      "type": "integer",
                      "const": 4
                    },
                    "maxTriangles": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16384
                    }
                  }
                }
              }
            },
            "sourceTopology": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "receipt", "receiptSha256"],
              "properties": {
                "method": { "const": "reviewed-source-corners-v1" },
                "receipt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^\\.opencaw/\\.cache/tasks/[^/]+/.+\\.json$"
                },
                "receiptSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "description": "Explicit reviewed source-corner index ownership. Requires constrained lods and the exact active-task receipt path/hash in reviewed authoring.sources. Managed/native validation additionally verifies confinement, bounded typed owners and actual prepared GLB/node/corner identities. No automatic weld, geometry repair, fallback or quality acceptance."
            },
            "importNormals": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "const": "stored-corner-fan-v1"
                }
              },
              "description": "Optional explicit versioned stored-corner fan decoder profile. Fixed published precision/search limits; caller tolerances and fallbacks are forbidden. Omission retains strict raw import behavior. Structural selection alone cannot certify native conversion or visual quality."
            },
            "lods": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "maxVertexSurfaceErrorMetres"
              ],
              "properties": {
                "method": {
                  "const": "original-component-finite-collapse-v1"
                },
                "contactPolicy": {
                  "type": "string",
                  "const": "protected-contact-rings-v1",
                  "description": "Optional explicit protected contact one-ring retention. Requires reviewed sourceTopology. Omission retains the exact existing contact policy; no fallback, owner welding or budget waiver."
                },
                "maxVertexSurfaceErrorMetres": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  }
                }
              },
              "description": "Explicit original-component-preserving finite collapse with versioned material-aware UV policy. World-metre per-level all-vertex/surface bounds must match recipe.lodRatios count before launch. Ratios and whole-package budgets retain existing contract authority. No fallback or implicit retention waiver."
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxPrivateBytes"
          ],
          "properties": {
            "maxPrivateBytes": {
              "type": "integer",
              "minimum": 67108864,
              "maximum": 68719476736
            }
          }
        }
      }
    }
  }
}
