{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed rigid source-corner topology receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "preparedGlbSha256", "meshes"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "const": "rigid-source-corner-topology" },
    "preparedGlbSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "meshes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "fileNodeIndex", "sourceVertexCount", "indexedCorners", "ownersI32LEHex", "ownersSha256"],
        "properties": {
          "node": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
          "fileNodeIndex": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "sourceVertexCount": { "type": "integer", "minimum": 1, "maximum": 8000000 },
          "indexedCorners": { "type": "integer", "minimum": 3, "maximum": 16777216, "multipleOf": 3 },
          "ownersI32LEHex": { "type": "string", "minLength": 24, "maxLength": 134217728, "pattern": "^[a-f0-9]+$" },
          "ownersSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "description": "File cap64MiB/depth12 and exact integer tokens are enforced by managed/native readers. Each hex field is exactly8*indexedCorners characters containing little-endian signed32-bit vertex owners; readers verify its SHA256, complete0..sourceVertexCount-1 coverage, unique LOW/node selection and prepared GLB corner correspondence. This receipt preserves reviewed index ownership; it does not certify topology, physical intersections, normals, materials, clearance or visual readiness."
}
