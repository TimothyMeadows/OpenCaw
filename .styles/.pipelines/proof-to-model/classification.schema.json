{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencaw.local/schemas/proof-to-model/classification-v1",
  "title": "Original-source-only anatomy and structure classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceSetHash",
    "sources",
    "sourceViews",
    "researchStatus",
    "researchReason",
    "research",
    "subjects",
    "relations",
    "unknowns",
    "preservationConstraints",
    "prohibitedSubstitutions",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceSetHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "sha256"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "researchStatus": {
      "enum": [
        "performed",
        "not-required"
      ]
    },
    "researchReason": {
      "type": "string",
      "minLength": 1
    },
    "research": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "title",
          "sourceQuestion",
          "sourceIds",
          "retrievedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "sourceQuestion": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
            }
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "classification",
          "sourceIds",
          "claims",
          "parts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
          },
          "kind": {
            "enum": [
              "living",
              "nonliving",
              "assembly",
              "unknown"
            ]
          },
          "classification": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
            }
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "description",
                "sourceIds",
                "confidence",
                "disposition"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
                  }
                },
                "confidence": {
                  "enum": [
                    "high",
                    "medium",
                    "low",
                    "unknown"
                  ]
                },
                "disposition": {
                  "enum": [
                    "observed",
                    "research-inferred",
                    "user-specified",
                    "unknown"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "impact": {
                  "type": "string",
                  "minLength": 1
                },
                "alternatives": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "researchIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "disposition": {
                        "const": "research-inferred"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "basis",
                      "impact",
                      "alternatives",
                      "researchIds"
                    ]
                  }
                }
              ]
            }
          },
          "parts": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "sourceIds",
                "visibility",
                "disposition",
                "claimIds"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
                  }
                },
                "visibility": {
                  "enum": [
                    "visible",
                    "partial",
                    "hidden",
                    "unknown"
                  ]
                },
                "disposition": {
                  "enum": [
                    "observed",
                    "research-inferred",
                    "user-specified",
                    "unknown"
                  ]
                },
                "claimIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "visibility": {
                        "const": "hidden"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "disposition": {
                        "not": {
                          "const": "observed"
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "type",
          "description",
          "sourceIds"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "impact",
          "sourceIds",
          "requiresResolution"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
            }
          },
          "requiresResolution": {
            "type": "boolean"
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preservationConstraints": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prohibitedSubstitutions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflicts": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "sourceIds",
          "resolved"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
            }
          },
          "resolved": {
            "type": "boolean"
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sourceViews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "view",
          "usable",
          "reason"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
          },
          "view": {
            "enum": [
              "front",
              "right",
              "back",
              "left",
              "top",
              "bottom",
              "oblique",
              "unknown"
            ]
          },
          "usable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "view": {
                  "enum": [
                    "oblique",
                    "unknown"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "usable": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    }
  }
}
