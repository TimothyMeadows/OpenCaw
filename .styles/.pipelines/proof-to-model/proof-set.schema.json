{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencaw.local/schemas/proof-to-model/proof-set-v1",
  "title": "Six-angle proof selection with immutable revisions and explicit generation authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "sourceSetHash",
    "classificationHash",
    "camera",
    "views"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "sourceSetHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "classificationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convention",
        "calibration",
        "meshScale",
        "cameraAngleX",
        "distance"
      ],
      "properties": {
        "convention": {
          "const": "blender-nerf-z-up"
        },
        "calibration": {
          "enum": [
            "nominal-prescribed",
            "measured"
          ]
        },
        "meshScale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cameraAngleX": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 3.141592653589793
        },
        "distance": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "view",
          "image",
          "sha256",
          "origin",
          "sourceIds",
          "cameraToWorld",
          "revision"
        ],
        "properties": {
          "view": {
            "enum": [
              "front",
              "right",
              "back",
              "left",
              "top",
              "bottom"
            ]
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "enum": [
              "source",
              "generated"
            ]
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
            }
          },
          "cameraToWorld": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            }
          },
          "cameraAngleX": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 3.141592653589793,
            "description": "Optional per-view horizontal field of view; takes precedence over the shared camera value."
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "generationReceipt": {
            "type": "string",
            "minLength": 1
          },
          "generationReceiptHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "generated"
                }
              }
            },
            "then": {
              "required": [
                "generationReceipt"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "generationReceipt"
                ]
              }
            }
          }
        ]
      }
    },
    "generationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline",
        "mediaContract",
        "mediaContractHash",
        "authorization"
      ],
      "properties": {
        "pipeline": {
          "enum": [
            "CLOUD",
            "LOCAL"
          ]
        },
        "mediaContract": {
          "const": "MEDIA.md"
        },
        "mediaContractHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorization": {
          "type": "string",
          "minLength": 1
        },
        "authorizationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "previousProofSetHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewStatus": {
      "const": "pending"
    },
    "revisedViews": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "front",
          "right",
          "back",
          "left",
          "top",
          "bottom"
        ]
      }
    }
  },
  "$defs": {
    "generationAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "authorized",
        "purpose",
        "pipeline",
        "sourceSetHash",
        "classificationHash",
        "mediaContractHash",
        "actor",
        "reason",
        "maxGeneratedCandidates",
        "maxRevisionsPerView"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "authorized": {
          "const": true
        },
        "purpose": {
          "const": "proof-to-model-multiview"
        },
        "pipeline": {
          "enum": [
            "CLOUD",
            "LOCAL"
          ]
        },
        "sourceSetHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "classificationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mediaContractHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "maxGeneratedCandidates": {
          "type": "integer",
          "minimum": 1
        },
        "maxRevisionsPerView": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "views": {
            "contains": {
              "properties": {
                "origin": {
                  "const": "generated"
                }
              },
              "required": [
                "origin"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "generationPolicy"
        ]
      }
    }
  ]
}
