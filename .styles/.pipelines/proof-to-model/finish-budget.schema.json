{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencaw.dev/schemas/proof-to-model/finish-budget.schema.json",
  "title": "One additional human-authorized finishing attempt",
  "$comment": "Native parsing caps UTF-8 at16384 bytes and rejects duplicate keys. Evidence must be a task-local regular confined file. Native context validation requires an exhausted configured finish budget, the exact current manifest hash and consumed count, and maxFinishAttempts=consumedFinishAttempts+1; a subsequent history/manifest change makes the receipt stale. This assertion does not authenticate a human or accept model quality.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "stage", "decision", "human", "reviewer", "reason", "manifestSha256", "consumedFinishAttempts", "maxFinishAttempts"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "kind": {"const": "finish-attempt-budget"},
    "stage": {"const": "finish"},
    "decision": {"const": "approved"},
    "human": {"const": true},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 200, "allOf": [{"pattern": "[^\u0009-\u000D\u0020\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000]"}, {"not": {"pattern": "[\u0000-\u001F\u007F-\u009F\u2028\u2029]"}}]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "[^\u0009-\u000D\u0020\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000]"},
    "manifestSha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "consumedFinishAttempts": {"type": "integer", "minimum": 0, "maximum": 99},
    "maxFinishAttempts": {"type": "integer", "minimum": 1, "maximum": 100}
  }
}
